    "scope": "markdown",
    "prefix": "project",
    "description": "README for a project in a Projects folder",
    "body": [
      "# ${1:Project name}",
      "",
      "${2:One line: what it does.}",
      "",
      "## How to run",
      "```",
      "${3:command}",
      "```",
      "",
