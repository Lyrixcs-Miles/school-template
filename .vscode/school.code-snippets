  "Job application row": {
    "scope": "markdown",
    "prefix": "apply",
    "description": "A row for Planning/Career/job-applications.md",
    "body": [
      "| $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE | ${1:Company} | ${2:Role} | ${3:Link} | ${4|Applied,Interview,Offer,Rejected|} | ${5:Next step} |"
    ]
  },
  "C++ header file": {
    "scope": "cpp",
    "prefix": "cppheader",
    "description": "A .h file with an include guard",
    "body": [
      "#pragma once",
      "",
      "// ${1:What this file declares}",
      "$0"
    ]
  },
  "C++ read numbers into a vector": {
    "scope": "cpp",
    "prefix": "cppinput",
    "description": "Read n numbers from the user into a vector",
    "body": [
      "int ${1:n};",
      "std::cout << \"How many numbers? \";",
      "std::cin >> ${1:n};",
      "std::vector<int> ${2:nums}(${1:n});",
      "for (auto& x : ${2:nums}) std::cin >> x;",
      "$0"
    ]
  },
  "Python safe number input": {
    "scope": "python",
    "prefix": "pyinput",
    "description": "Ask for a number until the user types a valid one",
    "body": [
      "while True:",
      "    try:",
      "        ${1:number} = int(input(\"${2:Enter a number: }\"))",
      "        break",
      "    except ValueError:",
      "        print(\"That's not a number, try again.\")",
      "$0"
    ]
  },
  "Python read a file": {
    "scope": "python",
    "prefix": "pyread",
    "description": "Read a text file line by line",
    "body": [
      "with open(\"${1:data.txt}\", encoding=\"utf-8\") as f:",
      "    for line in f:",
      "        line = line.strip()",
      "        ${0:print(line)}"
    ]
  },
  "Python test file": {
    "scope": "python",
    "prefix": "pytest",
    "description": "A pytest test (run with: python -m pytest)",
    "body": [
      "from ${1:module} import ${2:function}",
      "",
      "",
      "def test_${2:function}():",
      "    assert ${2:function}(${3:input}) == ${4:expected}",
      "$0"
    ]
  },
  "JS click handler": {
    "scope": "javascript",
    "prefix": "jsclick",
    "description": "Run code when an element is clicked",
    "body": [
      "document.querySelector(\"${1:#button}\").addEventListener(\"click\", () => {",
      "  $0",
      "});"
    ]
  },
  "JS fetch JSON": {
    "scope": "javascript",
    "prefix": "jsfetch",
    "description": "Get JSON data from an API",
    "body": [
      "async function ${1:loadData}() {",
      "  const response = await fetch(\"${2:https://api.example.com/data}\");",
      "  const data = await response.json();",
      "  ${0:console.log(data);}",
      "}",
      "${1:loadData}();"
    ]
  },
  "SQL create table": {
    "scope": "sql",
    "prefix": "sqltable",
    "description": "A CREATE TABLE statement",
    "body": [
      "CREATE TABLE ${1:table_name} (",
      "    id   INTEGER PRIMARY KEY,",
      "    ${2:name} ${3|TEXT,INTEGER,REAL|} NOT NULL$0",
      ");"
    ]
  },
  "SQL select": {
    "scope": "sql",
    "prefix": "sqlselect",
    "description": "A SELECT query",
    "body": [
      "SELECT ${1:*}",
      "FROM ${2:table_name}",
      "WHERE ${3:condition}",
      "ORDER BY ${4:column};"
    ]
  },
  "Bash script": {
    "scope": "shellscript",
    "prefix": "bashscript",
    "description": "A safe Bash script skeleton",
    "body": [
      "#!/usr/bin/env bash",
      "# ${1:What this script does}",
      "set -euo pipefail",
      "",
      "$0"
    ]
  },
  "Dockerfile for Python": {
    "scope": "dockerfile",
    "prefix": "dockerpy",
    "description": "Run a Python app in a container",
    "body": [
      "FROM python:3.14-slim",
      "WORKDIR /app",
      "COPY requirements.txt .",
      "RUN pip install --no-cache-dir -r requirements.txt",
      "COPY . .",
      "CMD [\"python\", \"${1:main.py}\"]"
    ]
  },
  "Bug note": {
    "scope": "markdown",
    "prefix": "bug",
    "description": "Record a bug or error and how you fixed it",
    "body": [
      "### Bug: ${1:short description}",
      "- **Error / what happened:** ${2:paste the error message}",
      "- **Cause:** ${3:why it happened}",
      "- **Fix:** ${4:what I changed}",
      "- **Lesson:** ${0:what to remember next time}",
      ""
    ]
  },
