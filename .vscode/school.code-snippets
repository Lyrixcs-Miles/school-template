{
  "C++ main program": {
    "scope": "cpp",
    "prefix": "cppmain",
    "body": [
      "#include <iostream>",
      "#include <string>",
      "#include <vector>",
      "",
      "int main() {",
      "    $0",
      "    return 0;",
      "}"
    ]
  },
  "C++ class": {
    "scope": "cpp",
    "prefix": "cppclass",
    "body": [
      "class ${1:Name} {",
      "public:",
      "    ${1:Name}(${2}) {}",
      "",
      "    $0",
      "private:",
      "};"
    ]
  },
  "Python main program": {
    "scope": "python",
    "prefix": "pymain",
    "body": [
      "def main() -> None:",
      "    ${0:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()"
    ]
  },
  "Python class": {
    "scope": "python",
    "prefix": "pyclass",
    "body": [
      "class ${1:Name}:",
      "    def __init__(self${2}) -> None:",
      "        ${0:pass}"
    ]
  },
