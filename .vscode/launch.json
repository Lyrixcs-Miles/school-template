{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current C++ file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "cwd": "${fileDirname}",
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build current C++ file (debug)",
      "setupCommands": [
        {
          "description": "Pretty-print STL containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Run current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    }
  ]
}
